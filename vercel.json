{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/landmark",
      "destination": "/landmark/index.html"
    },
    {
      "source": "/landmark/(.*)",
      "destination": "/landmark/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}