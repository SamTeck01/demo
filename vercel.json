{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/aria-global",
      "destination": "/aria-global/index.html"
    },
    {
      "source": "/aria-global/(.*)",
      "destination": "/aria-global/index.html"
    },
    {
      "source": "/austin-boutique",
      "destination": "/austin-boutique/index.html"
    },
    {
      "source": "/austin-boutique/(.*)",
      "destination": "/austin-boutique/index.html"
    },
    {
      "source": "/cedar-park-living",
      "destination": "/cedar-park-living/index.html"
    },
    {
      "source": "/cedar-park-living/(.*)",
      "destination": "/cedar-park-living/index.html"
    },
    {
      "source": "/graham-central",
      "destination": "/graham-central/index.html"
    },
    {
      "source": "/graham-central/(.*)",
      "destination": "/graham-central/index.html"
    },
    {
      "source": "/habitat-hunters",
      "destination": "/habitat-hunters/index.html"
    },
    {
      "source": "/habitat-hunters/(.*)",
      "destination": "/habitat-hunters/index.html"
    },
    {
      "source": "/landmark",
      "destination": "/landmark/index.html"
    },
    {
      "source": "/landmark/(.*)",
      "destination": "/landmark/index.html"
    },
    {
      "source": "/mahogany",
      "destination": "/mahogany/index.html"
    },
    {
      "source": "/mahogany/(.*)",
      "destination": "/mahogany/index.html"
    },
    {
      "source": "/ocean-club",
      "destination": "/ocean-club/index.html"
    },
    {
      "source": "/ocean-club/(.*)",
      "destination": "/ocean-club/index.html"
    },
    {
      "source": "/west-austin",
      "destination": "/west-austin/index.html"
    },
    {
      "source": "/west-austin/(.*)",
      "destination": "/west-austin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
